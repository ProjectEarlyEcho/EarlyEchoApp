{
  "name": "EarlyEcho — Parent follow-up and referral reminders",
  "id": "a7fc2849-d1d5-4816-a1cf-a7862251dddf",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 9 * * 1"
            }
          ]
        }
      },
      "id": "b1aa7edc-5a66-4b71-af4e-a3cd7ad79af1",
      "name": "Monday 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
